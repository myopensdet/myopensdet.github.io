# Template from myOpenSDET: https://myopensdet.github.io/
# Copy to .env in the project folder: cp config/.env.example .env
# .env is git-ignored. These are fake passwords for databases on your own computer only.
POSTGRES_PASSWORD=local_only_password
MYSQL_PASSWORD=local_only_password
MONGO_PASSWORD=local_only_password

# Optional: if a port is already taken on your computer (for example by a MySQL
# you installed), pick another one here. docker-compose.yml and the tests both use it.
# POSTGRES_PORT=5432
# MYSQL_PORT=3307
# MONGO_PORT=27017
